# The compiled application itself is distributed as a verified GitHub Release ZIP.
# The repository contains only the small bootstrap launcher and documentation.
/NETMAP
/NETMAP-*.zip
/NETMAP-*.tar.xz
/SHA256SUMS
/.runtime/

# Never put the NETMAP application source or development artifacts here.
*.py
*.pyw
*.pyc
*.pyo
tests/
tools/
src/
.venv/
venv/
build/
dist/
*.build/
*.dist/

# Sensitive or local data must not be committed.
.env*
*.env
*credentials*
*secrets*
*.db
*.sqlite*
*.log
__pycache__/
